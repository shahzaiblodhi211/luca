# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local Next.js preview workspaces (per-chat next dev)
/.preview-runtime/
/.preview-workspaces/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Gemini API key pool (never commit)
gemini-keys.txt
*.keys.txt
.gemini-key-state.json

# vercel
.vercel
deploy/vercel-env-import.env

# typescript
*.tsbuildinfo
next-env.d.ts
